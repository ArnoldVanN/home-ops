{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Brussels",
  // Flux and Kubernetes managers have no default file patterns for this layout
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      // Release assets pulled in as remote kustomize resources, e.g. system-upgrade-controller
      customType: "regex",
      description: "GitHub release download URLs in kustomizations",
      managerFilePatterns: ["/^kubernetes/.+/kustomization\\.ya?ml$/"],
      matchStrings: [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "# renovate: annotations above a version or tag field",
      managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:version|tag): \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
  ],
  packageRules: [
    {
      description: "k3s: one minor at a time, minors need a manual merge",
      matchDepNames: ["k3s-io/k3s"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$",
      separateMultipleMinor: true,
    },
    {
      description: "Automerge patch updates; Flux alerts and Gatus report breakage in Discord",
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      // There's no CI, so don't wait for status checks
      ignoreTests: true,
    },
  ],
}
